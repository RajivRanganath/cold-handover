+            f"The settlement's reported net is {to_rupees_str(abs(arithmetic_gap))} INR "
+            f"{direction} what its own gross, fees, tax and refunds add up to, and no "
+            "record in the batch explains the difference."
+        )
+        missing.append("explanation for the settlement net against its components")
+        actions.append(
+            "Ask the provider to explain the reported net against gross, fees, tax "
+            "and refunds, and correct the settlement record if it was mis-keyed."
+        )
+
+    if residual:
+        parts.append(
+            f"Correcting the fee and tax variance still leaves "
+            f"{to_rupees_str(abs(residual))} INR unattributed, with no record "
+            "explaining it. A second, unproven discrepancy is present."
+        )
+        missing.append("explanation for the residual deduction")
+        actions.append(
+            "Recover the fee variance, and separately identify the counterparty of "
+            "the remaining deduction before closing."
+        )
+
+    return Decision(
+        case_id=case.case_id,
+        state=HUMAN_REVIEW_REQUIRED,
+        reason=" ".join(parts),
+        missing_evidence=missing,
+        suggested_action=" ".join(actions),
+    )
+
