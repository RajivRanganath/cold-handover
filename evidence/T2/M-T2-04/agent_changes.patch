--- a/ledgerguard/tests/test_settlement_status.py
+++ b/ledgerguard/tests/test_settlement_status.py
@@ -0,0 +1,365 @@
+"""Settlement status is respected by reconciliation.
+
+A pending or failed settlement has not paid anything out. It must never be able
+to close a payment: it is ignored by duplicate detection, by the invariants and
+by bank matching, and a payment left with no processed settlement is reported
+as a missing settlement, with the non-processed records attached as evidence.
+
+Nothing here touches the network. The investigator is a spy that records calls.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime, timedelta
+
+from ledgerguard.evidence.safety import AUTO_RESOLVED, HUMAN_REVIEW_REQUIRED
+from ledgerguard.ai.schemas import InvestigationResult
+from ledgerguard.ledger.models import (
+    BankEntry,
+    Batch,
+    CreditDebit,
+    ExceptionType,
+    Order,
+    Payment,
+    Settlement,
+    SettlementStatus,
+)
+from ledgerguard.ledger.money import gst_on_fee, platform_fee
+from ledgerguard.ledger.shadow_ledger import ShadowLedger
+from ledgerguard.pipeline import run
+from ledgerguard.reconciliation.matcher import MATCHED, reconcile_batch
+
+T0 = datetime(2026, 6, 10, 10, 0, 0)
+AMOUNT = 500000
+
+
+def _payment(pid: str = "pay_S1", amount: int = AMOUNT, captured_at=T0) -> Payment:
+    fee = platform_fee(amount)
+    return Payment(
+        payment_id=pid,
+        order_id=f"ord_{pid}",
+        amount=amount,
+        captured_at=captured_at,
+        fee=fee,
+        tax=gst_on_fee(fee),
+        reference=f"PAY/{pid}",
+    )
+
+
+def _order(payment: Payment) -> Order:
+    return Order(
+        order_id=payment.order_id,
+        merchant_id="mch_TEST",
+        amount=payment.amount,
+        created_at=T0,
+        customer_reference="cust_TEST",
+    )
+
+
+def _settlement(
+    sid: str,
+    payment: Payment,
+    status: SettlementStatus = SettlementStatus.PROCESSED,
+    net: int | None = None,
+) -> Settlement:
+    fee = platform_fee(payment.amount)
+    tax = gst_on_fee(fee)
+    consistent_net = payment.amount - fee - tax
+    return Settlement(
+        settlement_id=sid,
+        merchant_id="mch_TEST",
+        payment_ids=[payment.payment_id],
+        gross_amount=payment.amount,
+        fees=fee,
+        tax=tax,
+        refund_adjustments=0,
+        other_adjustments=0,
+        net_amount=consistent_net if net is None else net,
+        settlement_date=T0 + timedelta(days=2),
+        status=status,
+        reference=f"STL/{sid}",
+    )
+
+
+def _bank_for(settlement: Settlement, amount: int | None = None) -> BankEntry:
+    return BankEntry(
+        bank_entry_id=f"bnk_{settlement.settlement_id}",
+        amount=settlement.net_amount if amount is None else amount,
+        credit_or_debit=CreditDebit.CREDIT,
+        date=settlement.settlement_date,
+        reference=settlement.reference,
+    )
+
+
+def _batch(payments, settlements=(), bank=()) -> Batch:
+    orders = [_order(p) for p in payments]
+    return Batch(
+        orders=orders,
+        payments=list(payments),
+        settlements=list(settlements),
+        bank_entries=list(bank),
+    )
+
+
+def _only_case(batch: Batch):
+    cases, _ = reconcile_batch(batch)
+    assert len(cases) == 1
+    return cases[0]
+
+
+# ------------------------------------------------- req 1-2: never closes a payment
+def test_pending_settlement_does_not_settle_payment():
+    payment = _payment()
+    pending = _settlement("setl_P1", payment, SettlementStatus.PENDING)
+    batch = _batch([payment], [pending], [_bank_for(pending)])
+
+    case = _only_case(batch)
+    assert case.status == ExceptionType.MISSING_SETTLEMENT.value
+    assert case.settlement is None
+    assert case.invariants == []
+
+    exc = case.exception
+    ledger = ShadowLedger(batch)
+    assert exc.exception_type is ExceptionType.MISSING_SETTLEMENT
+    assert exc.expected_value == ledger.expected_for_payment(payment).net_amount
+    assert exc.observed_value == 0
+    assert exc.transaction_ids == [payment.payment_id, payment.order_id]
+
+
+def test_failed_settlement_does_not_settle_payment():
+    payment = _payment()
+    failed = _settlement("setl_F1", payment, SettlementStatus.FAILED)
+    case = _only_case(_batch([payment], [failed], [_bank_for(failed)]))
+
+    assert case.status == ExceptionType.MISSING_SETTLEMENT.value
+    assert case.settlement is None
+
+
+def test_missing_settlement_without_any_settlement_has_no_new_evidence_key():
+    payment = _payment()
+    case = _only_case(_batch([payment]))
+
+    assert case.status == ExceptionType.MISSING_SETTLEMENT.value
+    assert "non_processed_settlements" not in case.exception.evidence
+
+
+def test_pending_only_missing_settlement_matches_no_settlement_outcome():
+    """Same expected_value, observed_value and type as a payment with no settlement."""
+    payment = _payment()
+    bare = _only_case(_batch([payment])).exception
+    pending = _only_case(
+        _batch([payment], [_settlement("setl_P1", payment, SettlementStatus.PENDING)])
+    ).exception
+
+    assert pending.exception_type is bare.exception_type
+    assert pending.expected_value == bare.expected_value
+    assert pending.observed_value == bare.observed_value
+    assert pending.difference == bare.difference
+    assert pending.risk == bare.risk
+
+
+# ------------------------------------------------------------- req 3: evidence key
+def test_non_processed_evidence_lists_pending_and_failed_sorted_by_id():
+    payment = _payment()
+    settlements = [
+        _settlement("setl_C", payment, SettlementStatus.PENDING),
+        _settlement("setl_A", payment, SettlementStatus.FAILED),
+        _settlement("setl_B", payment, SettlementStatus.PENDING),
+    ]
+    case = _only_case(_batch([payment], settlements))
+
+    assert case.exception.evidence["non_processed_settlements"] == [
+        {"settlement_id": "setl_A", "status": "failed"},
+        {"settlement_id": "setl_B", "status": "pending"},
+        {"settlement_id": "setl_C", "status": "pending"},
+    ]
+
+
+def test_non_processed_evidence_keeps_only_status_values_pending_or_failed():
+    payment = _payment()
+    settlements = [
+        _settlement("setl_P", payment, SettlementStatus.PENDING),
+        _settlement("setl_F", payment, SettlementStatus.FAILED),
+    ]
+    entries = _only_case(_batch([payment], settlements)).exception.evidence[
+        "non_processed_settlements"
+    ]
+    assert set(entries[0]) == {"settlement_id", "status"}
+    assert {e["status"] for e in entries} <= {"pending", "failed"}
+
+
+# ----------------------------------------------- req 4: processed one is the match
+def test_processed_settlement_matches_and_ignores_non_processed_ones():
+    payment = _payment()
+    processed = _settlement("setl_OK", payment)
+    pending = _settlement("setl_PEND", payment, SettlementStatus.PENDING, net=1)
+    failed = _settlement("setl_FAIL", payment, SettlementStatus.FAILED, net=2)
+    batch = _batch(
+        [payment],
+        [processed, pending, failed],
+        [_bank_for(processed)],
+    )
+
+    case = _only_case(batch)
+    assert case.status == MATCHED
+    assert case.settlement.settlement_id == "setl_OK"
+    assert all(i.holds for i in case.invariants)
+    assert all("setl_PEND" not in i.detail and "setl_FAIL" not in i.detail
+               for i in case.invariants)
+
+
+def test_non_processed_settlement_cannot_cause_fee_mismatch_or_duplicate():
+    """A conflicting pending copy must not turn a clean case into a duplicate."""
+    payment = _payment()
+    processed = _settlement("setl_X", payment)
+    # Same id, different content, not processed: contradictory but irrelevant.
+    rival = _settlement("setl_X", payment, SettlementStatus.PENDING, net=7)
+    case = _only_case(_batch([payment], [processed, rival], [_bank_for(processed)]))
+
+    assert case.status == MATCHED
+    assert case.exception is None
+
+
+def test_processed_mismatch_still_reported_when_non_processed_present():
+    payment = _payment()
+    # Fee overcharged by 100 paise; net re-derived so only I2 (fee schedule) fails.
+    base = _settlement("setl_BAD", payment)
+    fees = base.fees + 100
+    bad_fee = base.model_copy(
+        update={
+            "fees": fees,
+            "net_amount": base.gross_amount - fees - base.tax,
+        }
+    )
+    pending = _settlement("setl_PEND", payment, SettlementStatus.PENDING)
+    case = _only_case(_batch([payment], [bad_fee, pending]))
+
+    assert case.status == ExceptionType.FEE_MISMATCH.value
+    assert case.settlement.settlement_id == "setl_BAD"
+    assert "non_processed_settlements" not in case.exception.evidence
+
+
+def test_multiple_processed_settlements_still_duplicate_and_ignore_pending():
+    payment = _payment()
+    a = _settlement("setl_A", payment)
+    b = _settlement("setl_B", payment)
+    pending = _settlement("setl_Z", payment, SettlementStatus.PENDING)
+    case = _only_case(_batch([payment], [a, b, pending]))
+
+    assert case.status == ExceptionType.DUPLICATE_RECORD.value
+    assert case.exception.evidence["settlement_ids"] == ["setl_A", "setl_B"]
+    assert "non_processed_settlements" not in case.exception.evidence
+
+
+# --------------------------------------------- req 5: payment duplicates unchanged
+def test_duplicate_payment_precedence_unchanged_with_pending_settlement():
+    payment = _payment()
+    pending = _settlement("setl_P", payment, SettlementStatus.PENDING)
+    batch = _batch([payment, payment], [pending])
+    case = _only_case(batch)
+
+    assert case.status == ExceptionType.DUPLICATE_RECORD.value
+    assert case.exception.evidence["reason"] == "payment_id appears more than once in the batch"
+    assert "non_processed_settlements" not in case.exception.evidence
+    assert "setl_P" not in case.exception.transaction_ids
+
+
+def test_conflicting_payment_duplicate_precedence_unchanged_with_pending_settlement():
+    payment = _payment()
+    other = payment.model_copy(update={"amount": payment.amount + 100})
+    case = _only_case(_batch([payment, other], [_settlement("setl_P", payment, SettlementStatus.FAILED)]))
+
+    assert case.status == ExceptionType.DUPLICATE_RECORD.value
+    assert case.exception.evidence["content_conflict"] == "payment"
+    assert "non_processed_settlements" not in case.exception.evidence
+
+
+# --------------------------------------------- req 1: ignored by bank matching
+def test_bank_credit_for_pending_settlement_does_not_close_payment():
+    payment = _payment()
+    pending = _settlement("setl_P", payment, SettlementStatus.PENDING)
+    # A bank credit exists that matches the pending settlement exactly.
+    batch = _batch([payment], [pending], [_bank_for(pending)])
+    ledger = ShadowLedger(batch)
+
+    assert ledger.settlements_for(payment.payment_id) == []
+    case = _only_case(batch)
+    assert case.status == ExceptionType.MISSING_SETTLEMENT.value
+    assert case.exception.evidence["non_processed_settlements"] == [
+        {"settlement_id": "setl_P", "status": "pending"}
+    ]
+
+
+def test_index_separates_processed_from_non_processed():
+    payment = _payment()
+    processed = _settlement("setl_OK", payment)
+    pending = _settlement("setl_P", payment, SettlementStatus.PENDING)
+    failed = _settlement("setl_F", payment, SettlementStatus.FAILED)
+    ledger = ShadowLedger(_batch([payment], [processed, pending, failed]))
+
+    assert [s.settlement_id for s in ledger.settlements_for(payment.payment_id)] == ["setl_OK"]
+    assert [s.settlement_id for s in ledger.non_processed_settlements_for(payment.payment_id)] == [
+        "setl_P",
+        "setl_F",
+    ]
+
+
+def test_non_processed_settlement_sharing_id_with_processed_creates_no_conflict():
+    """find_duplicates must only see processed settlements."""
+    payment_a = _payment("pay_A")
+    payment_b = _payment("pay_B")
+    processed_a = _settlement("setl_SHARED", payment_a)
+    # Same id as a processed record, different content, not processed.
+    pending_b = _settlement("setl_SHARED", payment_b, SettlementStatus.PENDING, net=3)
+    batch = _batch(
+        [payment_a, payment_b],
+        [processed_a, pending_b],
+        [_bank_for(processed_a)],
+    )
+    cases, _ = reconcile_batch(batch)
+    by_pid = {c.payment_id: c for c in cases}
+
+    assert by_pid["pay_A"].status == MATCHED
+    assert by_pid["pay_A"].exception is None
+    assert by_pid["pay_B"].status == ExceptionType.MISSING_SETTLEMENT.value
+    assert "content_conflict" not in by_pid["pay_B"].exception.evidence
+
+
+# ---------------------------------- req 7: end-to-end controller never investigates
+class _SpyProvider:
+    name = "spy"
+
+    def __init__(self) -> None:
+        self.calls: list[dict] = []
+
+    def investigate(self, context: dict) -> InvestigationResult:
+        self.calls.append(context)
+        return InvestigationResult.unavailable("spy: should never be called")
+
+
+def test_end_to_end_never_investigates_or_auto_resolves_non_processed_cases():
+    pending_payment = _payment("pay_PEND")
+    failed_payment = _payment("pay_FAIL")
+    clean_payment = _payment("pay_OK")
+    pending = _settlement("setl_PEND", pending_payment, SettlementStatus.PENDING)
+    failed = _settlement("setl_FAIL", failed_payment, SettlementStatus.FAILED)
+    clean = _settlement("setl_OK", clean_payment)
+    batch = _batch(
+        [pending_payment, failed_payment, clean_payment],
+        [pending, failed, clean],
+        [_bank_for(pending), _bank_for(failed), _bank_for(clean)],
+    )
+
+    spy = _SpyProvider()
+    report = run(batch, use_ai=True, provider=spy)
+
+    assert spy.calls == []
+    by_pid = report.by_case_id()
+    for pid in ("pay_PEND", "pay_FAIL"):
+        outcome = by_pid[pid]
+        assert outcome.case.exception.exception_type is ExceptionType.MISSING_SETTLEMENT
+        assert outcome.investigation is None
+        assert outcome.state == HUMAN_REVIEW_REQUIRED
+        assert outcome.state != AUTO_RESOLVED
+    assert by_pid["pay_OK"].state == "MATCHED"
+    assert report.investigations == 0
